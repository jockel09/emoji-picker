#!/bin/sh
# Group membership is per user, so it can't be done from here: this runs as
# root and for no particular user. Point at the helper instead, which also
# saves people from typing the usermod line ydotool just printed.
set -e

case "$1" in
    configure)
        cat <<'EOF'

  Emoji Picker installed. One step left — run this as your own user, not
  with sudo. It takes care of the group note ydotool printed above:

      emoji-picker-setup

  Until that is done and you have logged back in, picking an emoji only
  copies it to the clipboard instead of inserting it.

EOF
        ;;
esac

exit 0
