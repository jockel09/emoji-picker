#!/bin/bash
# ─────────────────────────────────────────────
# Emoji Picker — per-user setup
#
# Direct insertion writes to /dev/uinput, which udev grants to group 'input'.
# That membership belongs to your account, so no package install can arrange
# it for you.
#
# The ydotool service is already enabled system-wide by the ydotool package
# itself, so it starts on its own at your next login. Starting it here just
# saves the wait when you are in the group already.
# ─────────────────────────────────────────────
set -e

if [ "$(id -u)" -eq 0 ]; then
    echo "  ❌ Run this as your own user, not as root — these settings are per user."
    exit 1
fi

echo ""
echo "  🎨 Emoji Picker — setup"
echo "  ───────────────────────"
echo ""

NEED_RELOGIN=false

# Offer to install ydotool, enabling Debian's backports first if that is the
# only place it exists. Returns 0 once ydotool is installed.
#
# Availability is decided by asking apt to simulate the install, not by reading
# the sources: no codename to hardcode, no locale to worry about. The backports
# offer is limited to ID=debian, because writing Debian's backports into an
# Ubuntu or Devuan sources list mixes distributions and breaks systems.
install_ydotool() {
    local id codename list
    id=$(. /etc/os-release 2>/dev/null && echo "${ID:-}")
    codename=$(. /etc/os-release 2>/dev/null && echo "${VERSION_CODENAME:-}")

    if apt-get install -s ydotool &>/dev/null; then
        read -p "  Install ydotool now? [Y/n] " answer
        [[ "$answer" != "n" && "$answer" != "N" ]] || return 1
    else
        [ "$id" = "debian" ] && [ -n "$codename" ] || return 1
        echo "     On Debian it only exists in ${codename}-backports."
        echo "     Enabling it adds an apt source, so this changes your package"
        echo "     management, not just this program."
        read -p "  Enable ${codename}-backports and install ydotool? [Y/n] " answer
        [[ "$answer" != "n" && "$answer" != "N" ]] || return 1

        list="/etc/apt/sources.list.d/${codename}-backports.list"
        echo "  🔧 Adding $list"
        echo "deb http://deb.debian.org/debian ${codename}-backports main" \
            | sudo tee "$list" >/dev/null
        sudo apt-get update || return 1
    fi

    sudo apt-get install -y ydotool
}

# ── /dev/uinput access ───────────────────────
if id -nG | tr ' ' '\n' | grep -qx input; then
    echo "  ✅ Already in group 'input'"
else
    echo "  🔧 Adding $USER to group 'input' (asks for sudo)..."
    sudo usermod -aG input "$USER"
    NEED_RELOGIN=true
    echo "  ✅ Added"
fi

# ── ydotool ──────────────────────────────────
# Only in backports on Debian, so it is a Recommends and may be absent
YDOTOOL_MISSING=false
SERVICE_FAILED=false
if ! command -v ydotool >/dev/null 2>&1; then
    echo "  ⚠️  ydotool is not installed — it is what inserts emojis directly."
    if install_ydotool; then
        echo "  ✅ ydotool installed"
    else
        YDOTOOL_MISSING=true
    fi
fi

if [ "$YDOTOOL_MISSING" = false ]; then
    if systemctl --user is-active ydotool &>/dev/null; then
        echo "  ✅ ydotool service already running"
    else
        echo "  🔧 Starting the ydotool service..."
        systemctl --user enable --now ydotool 2>/dev/null || true
        if systemctl --user is-active ydotool &>/dev/null; then
            echo "  ✅ ydotool service running"
        else
            SERVICE_FAILED=true
            echo "  ⚠️  Could not start it yet."
            if [ "$NEED_RELOGIN" = true ]; then
                echo "     Expected — the group change isn't active in this session."
            else
                echo "     Check: systemctl --user status ydotool"
            fi
        fi
    fi
fi

echo ""
if [ "$NEED_RELOGIN" = true ]; then
    echo "  ⚠️  Log out and back in for the group change to take effect,"
    echo "     then run 'emoji-picker-setup' again to finish."
elif [ "$YDOTOOL_MISSING" = true ]; then
    echo "  The picker works, but only copies to the clipboard."
    echo "  Run 'emoji-picker-setup' again whenever you want to add ydotool."
elif [ "$SERVICE_FAILED" = true ]; then
    echo "  The picker works, but insertion needs the ydotool service running."
    echo "  Nothing else to set up once it is up."
else
    echo "  Done. Start it with 'emoji-picker', or bind it to a shortcut:"
    echo "  System Settings → Keyboard → Shortcuts → + Add New → Command"
fi
echo ""
